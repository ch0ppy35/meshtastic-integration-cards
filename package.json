{
  "name": "meshtastic-chat-card",
  "description": "Lovelace cards for the meshtastic Home Assistant integration: channel chat and gateway radio status.",
  "repository": "https://github.com/ch0ppy35/meshtastic-integration-cards",
  "author": "Mike Miller",
  "version": "1.3.0",
  "module": "meshtastic-chat-card.js",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "hacs",
    "lovelace",
    "custom-cards",
    "meshtastic",
    "chat",
    "radio"
  ],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "home-assistant-js-websocket": "9.7.1",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "rollup": "^4.65.0",
    "rollup-plugin-gzip": "^4.2.0",
    "rollup-plugin-serve": "^3.0.0",
    "rollup-plugin-typescript2": "^0.37.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "rollup -c rollup.config.dev.js --watch",
    "demo": "rollup -c rollup.config.demo.js --watch",
    "build": "yarn rollup",
    "lint": "eslint src/ --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "rollup": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "packageManager": "yarn@4.14.1"
}
